# Создайте .env на основе этого файла, в .gitignore он уже добавлен.
# Токен НЕ отправляйте в чат или на GitHub.
BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_ИЗ_BOTFATHER
# Отдельный секрет для cookies, 32+ случайных символа.
SESSION_SECRET=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ

# Локальный сервер с Telegram-авторизацией через туннель.
# LOCAL_DEMO не включайте: у каждого Telegram ID должен быть свой игрок.
LOCAL_DEMO=0

# Временная БД остаётся на этом ПК, в файле yuzy_dev.sqlite3.
# DATABASE_URL не нужен.
